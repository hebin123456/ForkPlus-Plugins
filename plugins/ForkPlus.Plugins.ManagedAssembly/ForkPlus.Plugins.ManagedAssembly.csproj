<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 托管程序集对比视图插件：认领 .dll / .exe，命中后用共享框架内置的
         System.Reflection.Metadata / System.Reflection.PortableExecutable 读取 .NET 元数据
         （程序集标识 / 类型 → 方法 · 字段 / AssemblyRef 引用），提供「标识 / 类型 / 引用」三种 diff 视图。
         零第三方依赖：随包进 plugins/ 的只有插件自身主 DLL（不需要 third-party.json）。
         公共属性（net10.0 / AvaloniaVersion / 契约引用）见 ../Directory.Build.props。 -->
    <AssemblyName>ForkPlus.Plugins.ManagedAssembly</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.ManagedAssembly</RootNamespace>

    <!-- 插件自身版本（与宿主版本解耦）；偏好设置 → 插件页展示的 Version 与此一致。 -->
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本插件视图用 Avalonia 控件纯代码构建（未使用 .axaml）。
         运行期 Avalonia 由宿主提供，打包时不随插件分发（见 README「依赖与共享程序集」）。 -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>