<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 机器学习模型对比视图插件：认领 .onnx / .safetensors / .gguf，把两侧模型解析成统一的
         键路径行（元数据与张量）后做语义 diff，提供 Metadata / Tensors 两种视图。
         零第三方依赖：ONNX protobuf 线格式、SafeTensors、GGUF 全部自解析（MlModelParser）。
         公共属性（net10.0 / AvaloniaVersion / 契约引用）见 ../Directory.Build.props。 -->
    <AssemblyName>ForkPlus.Plugins.MlModel</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.MlModel</RootNamespace>

    <!-- 插件自身版本（与宿主版本解耦）；偏好设置 → 插件页展示的 Version 与此一致。 -->
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本插件视图用 Avalonia 控件纯代码构建（未使用 .axaml）。
         运行期 Avalonia 由宿主提供，打包时不随插件分发（见 README「依赖与共享程序集」）。 -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
