<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- EPUB 电子书对比视图插件：认领 .epub，用共享框架内置的 System.IO.Compression.ZipArchive
         解开 ZIP 容器，解析 container.xml → OPF（元数据 / manifest / spine），
         提供「元数据」与「章节」两种 diff 视图。
         零第三方依赖：ZIP 走 System.IO.Compression（ZipArchive），XML 走 System.Xml.Linq，
         均为共享框架内置（不需要 third-party.json）。
         公共属性（net10.0 / AvaloniaVersion / 契约引用）见 ../Directory.Build.props。 -->
    <AssemblyName>ForkPlus.Plugins.Epub</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.Epub</RootNamespace>

    <!-- 插件自身版本（与宿主版本解耦）；偏好设置 → 插件页展示的 Version 与此一致。 -->
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本插件视图用 Avalonia 控件纯代码构建（未使用 .axaml）。
         运行期 Avalonia 由宿主提供，打包时不随插件分发（见 README「依赖与共享程序集」）。 -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
