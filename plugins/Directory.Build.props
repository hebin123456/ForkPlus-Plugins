<Project>
  <!-- plugins/ 下所有插件的公共属性：每个插件 = 一个独立进程（OutputType=Exe）+ 一份 plugin.json。
       放在 plugins/ 而非仓库根，是为了不把 OutputType=Exe 误加到 sdk/ 里的库工程上。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 统一引用仓库内的 SDK 源码（sdk/ForkPlus.PluginSdk）。 -->
    <!-- 注意：plugin.json 的拷贝必须写在 Directory.Build.targets（此文件在 SDK 建立
         默认 None 项之前就被导入，此处 Update 会静默失效），见该文件的说明。 -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\sdk\ForkPlus.PluginSdk\ForkPlus.PluginSdk.csproj" />
  </ItemGroup>
</Project>