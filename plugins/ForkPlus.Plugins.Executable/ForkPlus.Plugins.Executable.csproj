<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 可执行文件 / 库对比视图插件：认领 .exe / .dll / .so / .dylib / .a / .lib / .wasm，
         命中后把两侧二进制各自解析成结构模型（格式 / 架构 / 节段 / 导入导出 / 体积构成）
         左右并排对比。零第三方依赖：PE 走共享框架内置的 System.Reflection.Metadata /
         System.Reflection.PortableExecutable（net10.0 自带，无需 PackageReference），
         ELF / Mach-O / WebAssembly / ar 自解析。
         公共属性（net10.0 / AvaloniaVersion / 契约引用）见 ../Directory.Build.props。 -->
    <AssemblyName>ForkPlus.Plugins.Executable</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.Executable</RootNamespace>

    <!-- 插件自身版本（与宿主版本解耦）；偏好设置 → 插件页展示的 Version 与此一致。 -->
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本插件视图用 Avalonia 控件纯代码构建（未使用 .axaml）。
         运行期 Avalonia 由宿主提供，打包时不随插件分发（见 README「依赖与共享程序集」）。 -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
