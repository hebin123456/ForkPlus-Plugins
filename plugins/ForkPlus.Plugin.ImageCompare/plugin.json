{
  "id": "com.forkplus.plugin.image-compare",
  "name": "Image Compare Viewer",
  "version": "1.0.0",
  "apiVersion": 1,
  "license": "MIT",
  "homepage": "https://github.com/hebin123456/ForkPlus-Plugins",
  "host": {
    "executable": "ForkPlus.Plugin.ImageCompare.dll"
  },
  "viewers": [
    {
      "id": "image",
      "displayName": "Image",
      "priority": 250,
      "extensions": [
        ".png", ".jpg", ".jpeg", ".jfif", ".bmp", ".gif", ".webp",
        ".tga", ".tif", ".tiff", ".pbm", ".pgm", ".ppm", ".qoi"
      ]
    }
  ]
}