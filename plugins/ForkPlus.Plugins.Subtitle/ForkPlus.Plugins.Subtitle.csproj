<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 字幕 / 时间轴对比视图插件：认领 .srt / .vtt / .ass / .ssa / .sub，把两侧解析成同一套
         cue 模型，先按文本对齐再按时间配对，提供字幕行表与等比时间轴两种视图。
         零第三方依赖：五种格式的解析与对齐全自实现（SubtitleParser / SubtitleDiff）。
         公共属性（net10.0 / AvaloniaVersion / 契约引用）见 ../Directory.Build.props。 -->
    <AssemblyName>ForkPlus.Plugins.Subtitle</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.Subtitle</RootNamespace>

    <!-- 插件自身版本（与宿主版本解耦）；偏好设置 → 插件页展示的 Version 与此一致。 -->
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本插件视图用 Avalonia 控件纯代码构建（未使用 .axaml）。
         运行期 Avalonia 由宿主提供，打包时不随插件分发（见 README「依赖与共享程序集」）。 -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
