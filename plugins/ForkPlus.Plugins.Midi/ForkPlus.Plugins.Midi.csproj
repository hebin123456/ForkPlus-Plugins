<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- MIDI 对比视图插件：认领 .mid / .midi，把两侧 SMF 解析成同一套
         音符模型，先按（通道, 音高, 起始毫秒）配对再判差异，提供音符表与钢琴卷帘时间轴两种视图。
         零第三方依赖：SMF 解析与对齐全自实现（MidiParser / MidiDiff）。
         公共属性（net10.0 / AvaloniaVersion / 契约引用）见 ../Directory.Build.props。 -->
    <AssemblyName>ForkPlus.Plugins.Midi</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.Midi</RootNamespace>

    <!-- 插件自身版本（与宿主版本解耦）；偏好设置 → 插件页展示的 Version 与此一致。 -->
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本插件视图用 Avalonia 控件纯代码构建（未使用 .axaml）。
         运行期 Avalonia 由宿主提供，打包时不随插件分发（见 README「依赖与共享程序集」）。 -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
