<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 音视频插件共享解码核心（FFmpeg.AutoGen 动态绑定 + 内存 AVIO + 元数据 / 波形 / 频谱 / 帧解码）。
         落位 sdk/ 而非 plugins/：CI 的插件发现是 plugins/*/*.csproj 全量构建并逐个打包，
         共享库放 plugins/ 会被当成一个「插件」打包出多余产物（见 design/audio-video-plugins.md §4）。
         本工程不引用契约程序集：纯解码，不做日志（错误以字符串返回，由插件侧记录）。 -->
    <AssemblyName>ForkPlus.Plugins.Media</AssemblyName>
    <RootNamespace>ForkPlus.Plugins.Media</RootNamespace>
    <Version>0.1.0</Version>

    <!-- FFmpeg 互操作全程指针操作。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- FFmpeg.AutoGen：LGPL 自包含动态绑定（包版本与 FFmpeg 发行版 9.0.x 同步，大版本必须一致）。
         该包自带 ffmpeg 类、DynamicallyLoadedBindings 与各平台解析器，运行期按 ffmpeg.RootPath
         dlopen / LoadLibrary 原生件，不静态链接。
         **不要再引 FFmpeg.AutoGen.Bindings.DynamicallyLoaded**：那是另一套并行、互不相通的绑定栈
         （FFmpeg.AutoGen.Abstractions + Bindings.DynamicallyLoaded），配置它影响不到本程序实际调用的
         FFmpeg.AutoGen.ffmpeg——自定义解析器永不被读取，Windows 上会因原生件依赖找不到而整段解码失败。 -->
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
  </ItemGroup>
</Project>
